{
  "entities": {
    "FestivalCard": {
      "title": "FestivalCard",
      "description": "A generated festival card stored persistently in Firestore with metadata and compressed visual asset",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique card document identifier"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp in ISO string"
        },
        "timestamp": {
          "type": "number",
          "description": "Epoch timestamp in milliseconds"
        },
        "festivalId": {
          "type": "string",
          "maxLength": 64,
          "description": "Identifier of the festival"
        },
        "festivalName": {
          "type": "string",
          "maxLength": 128,
          "description": "Display name of the festival"
        },
        "festivalIcon": {
          "type": "string",
          "maxLength": 16,
          "description": "Emoji icon of the festival"
        },
        "styleId": {
          "type": "string",
          "maxLength": 64,
          "description": "Visual style identifier"
        },
        "styleName": {
          "type": "string",
          "maxLength": 128,
          "description": "Visual style display name"
        },
        "greeting": {
          "type": "string",
          "maxLength": 500,
          "description": "Card greeting message"
        },
        "textStyle": {
          "type": "string",
          "enum": ["light", "dark", "gold", "neon"],
          "description": "Styling of the greeting text"
        },
        "aspectRatio": {
          "type": "string",
          "enum": ["1:1", "3:4", "4:3", "9:16", "16:9"],
          "description": "Selected aspect ratio"
        },
        "composedImage": {
          "type": "string",
          "maxLength": 800000,
          "description": "Base64 JPEG representation of the composed card"
        },
        "rawImage": {
          "type": "string",
          "maxLength": 800000,
          "description": "Base64 JPEG or PNG representation of the uncomposed generated image"
        },
        "resolution": {
          "type": "string",
          "enum": ["1K", "2K", "4K"],
          "description": "AI rendering resolution"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "description": "Creator user ID or anonymous client ID"
        },
        "isPublic": {
          "type": "boolean",
          "description": "Whether the card is publicly viewable in cloud gallery"
        }
      },
      "required": [
        "id",
        "timestamp",
        "festivalId",
        "festivalName",
        "greeting",
        "textStyle",
        "aspectRatio",
        "composedImage"
      ]
    }
  },
  "firestore": {
    "/cards/{cardId}": {
      "schema": {
        "$ref": "FestivalCard"
      },
      "description": "Collection of generated festival greeting cards persistently stored in Firestore"
    }
  }
}
